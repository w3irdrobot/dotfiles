# shellcheck shell=bash
# Owned fallback, not the mutable AUR recipe. Review before every bootstrap.
# Rust/Cargo are supplied build-only by modules/paru.sh, not native packages.
# makepkg consumes package metadata and sets srcdir/pkgdir.
# shellcheck disable=SC2034,SC2154
pkgname=paru
pkgver=2.1.0.r7830fac
pkgrel=1
pkgdesc='Feature packed AUR helper (pinned upstream source and committed lock)'
arch=('x86_64')
url='https://github.com/Morganamilo/paru'
license=('GPL-3.0-only')
depends=('git' 'pacman' 'openssl' 'libalpm.so=16-64')
makedepends=('base-devel')
options=('!lto')
backup=('etc/paru.conf')
_commit=7830fac148f8cd2143307386ead67d7ffd2efa33
_lock_sha256=10137b6b653655e5069618f1ca9071e4c104286d2a1deb7b7ea25a3eda2ea2e7
source=("paru-$_commit.tar.gz::https://codeload.github.com/Morganamilo/paru/tar.gz/$_commit")
sha256sums=('94869ec2dac20d3d34b5aa6cb32ffa6e2f1f434e79201287729a6028266e248a')

_verify_lock() {
	printf '%s  Cargo.lock\n' "$_lock_sha256" | sha256sum --check --status || {
		printf 'paru: committed Cargo.lock changed; refusing dependency resolution.\n' >&2
		return 1
	}
}

prepare() {
	cd "$srcdir/paru-$_commit" || return 1
	printf 'paru: upstream commit %s; archive SHA256 %s; Cargo.lock SHA256 %s\n' "$_commit" "${sha256sums[0]}" "$_lock_sha256" >&2
	_verify_lock || return 1
	[[ ${PARU_CARGO:-} == /nix/store/*/bin/cargo && ${RUSTC:-} == /nix/store/*/bin/rustc ]] || {
		printf 'paru: use the pinned build-only Nix Rust/Cargo environment.\n' >&2
		return 1
	}
	[[ $("$RUSTC" --version) == 'rustc 1.98.1 '* && $("$PARU_CARGO" --version) == 'cargo 1.98.1 '* ]] || {
		printf 'paru: pinned Rust/Cargo 1.98.1 required; refusing another toolchain.\n' >&2
		return 1
	}
	local status=0
	"$PARU_CARGO" fetch --locked --target x86_64-unknown-linux-gnu || status=$?
	_verify_lock || return 1
	return "$status"
}

build() {
	cd "$srcdir/paru-$_commit" || return 1
	_verify_lock || return 1
	# makepkg config/drop-ins and prepare_buildenv can replace exported flags.
	# Enforce native linking here, after they have run, not just in the launcher.
	export CC=/usr/bin/cc CXX=/usr/bin/c++ PKG_CONFIG=/usr/bin/pkg-config
	export PKG_CONFIG_LIBDIR=/usr/lib/pkgconfig:/usr/share/pkgconfig
	export RUSTFLAGS='-C linker=/usr/bin/cc -C linker-features=-lld -C link-self-contained=-linker'
	unset CARGO_ENCODED_RUSTFLAGS PKG_CONFIG_PATH LIBRARY_PATH LD_LIBRARY_PATH NIX_LDFLAGS
	local status=0
	"$PARU_CARGO" build --release --frozen --target x86_64-unknown-linux-gnu || status=$?
	_verify_lock || return 1
	((status == 0)) || return "$status"
	# Native cc links against native libraries, not Nix's runtime. Refuse any
	# interpreter/RPATH/NEEDED reference that would die after Nix garbage collection.
	local dynamic
	dynamic=$(/usr/bin/readelf --program-headers --dynamic target/x86_64-unknown-linux-gnu/release/paru) || return 1
	[[ $dynamic != *'/nix/store/'* ]] || {
		printf 'paru: binary has a Nix-store runtime reference; refusing installation.\n' >&2
		return 1
	}
}

package() {
	cd "$srcdir/paru-$_commit" || return 1
	_verify_lock || return 1
	install -Dm755 target/x86_64-unknown-linux-gnu/release/paru "$pkgdir/usr/bin/paru" || return 1
	install -Dm644 paru.conf "$pkgdir/etc/paru.conf" || return 1
	install -Dm644 man/paru.8 "$pkgdir/usr/share/man/man8/paru.8" || return 1
	install -Dm644 man/paru.conf.5 "$pkgdir/usr/share/man/man5/paru.conf.5" || return 1
	install -Dm644 completions/bash "$pkgdir/usr/share/bash-completion/completions/paru" || return 1
	install -Dm644 completions/fish "$pkgdir/usr/share/fish/vendor_completions.d/paru.fish" || return 1
	install -Dm644 completions/zsh "$pkgdir/usr/share/zsh/site-functions/_paru" || return 1
}
