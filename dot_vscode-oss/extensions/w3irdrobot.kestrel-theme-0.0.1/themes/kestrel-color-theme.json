  "tokenColors": [
    {
      "name": "Base foreground",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#F8F4EC"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6F8EAD",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.delete",
        "keyword.other.directive.using",
        "keyword.other.operator",
        "keyword.other.using",
        "source.cpp keyword.operator.new",
        "storage.modifier",
        "storage.type.function",
        "storage.type.async"
      ],
      "settings": {
        "foreground": "#BDD2E4"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "storage.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "entity.name.type",
        "entity.name.struct",
        "entity.name.enum",
        "entity.other.attribute",
        "entity.other.inherited-class",
        "meta.type.cast.expr",
        "meta.type.new.expr",
        "punctuation.separator.namespace.ruby",
        "storage.type.annotation.groovy",
        "storage.type.annotation.java",
        "storage.type.boolean.go",
        "storage.type.byte.go",
        "storage.type.cs",
        "storage.type.error.go",
        "storage.type.generic.cs",
        "storage.type.generic.groovy",
        "storage.type.generic.java",
        "storage.type.groovy",
        "storage.type.modifier.cs",
        "storage.type.numeric.go",
        "storage.type.object.array.groovy",
        "storage.type.object.array.java",
        "storage.type.parameters.groovy",
        "storage.type.primitive.array.groovy",
        "storage.type.primitive.array.java",
        "storage.type.primitive.groovy",
        "storage.type.primitive.java",
        "storage.type.rune.go",
        "storage.type.string.go",
        "storage.type.token.java",
        "storage.type.uintptr.go",
        "storage.type.variable.cs",
        "support.class",
        "support.constant.dom",
        "support.constant.json",
        "support.constant.math",
        "support.type"
      ],
      "settings": {
        "foreground": "#E5D1AF"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "support.constant.handlebars",
        "source.powershell variable.other.member",
        "entity.name.operator.custom-literal",
        "variable.function"
      ],
      "settings": {
        "foreground": "#93B1CC"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#E5BF8D"
      }
    },
    {
      "name": "String escapes and interpolation",
      "scope": [
        "constant.character.escape",
        "constant.character.escaped",
        "punctuation.section.embedded",
        "source string source"
      ],
      "settings": {
        "foreground": "#D8C3A0"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other.option",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#E78A50"
      }
    },
    {
      "name": "Enum members",
      "scope": [
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#BDD2E4"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "meta.definition.variable",
        "meta.definition.variable.name",
        "support.variable",
        "entity.name.variable",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#F8F4EC"
      }
    },
    {
      "name": "Language variables",
      "scope": [
        "variable.language",
        "variable.other.this",
        "variable.other.super"
      ],
      "settings": {
        "foreground": "#BDD2E4"
      }
    },
    {
      "name": "Properties and fields",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#F4EEE5"
      }
    },
    {
      "name": "Attributes, annotations, and macros",
      "scope": [
        "entity.other.attribute-name",
        "storage.type.annotation",
        "support.constant.attribute-name",
        "meta.annotation",
        "meta.attribute",
        "entity.name.function.macro"
      ],
      "settings": {
        "foreground": "#93B1CC"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#BDD2E4"
      }
    },
    {
      "name": "Punctuation and operators",
      "scope": [
        "keyword.operator",
        "entity.name.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#9C968A"
      }
    },
    {
      "name": "Brackets",
      "scope": [
        "punctuation.section",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments"
      ],
      "settings": {
        "foreground": "#F8F4EC"
      }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value",
        "support.constant.font-name",
        "support.constant.media-type",
        "support.constant.media",
        "constant.other.color.rgb-value",
        "constant.other.rgb-value",
        "support.constant.color"
      ],
      "settings": {
        "foreground": "#E5BF8D"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.character.character-class.regexp",
        "constant.character.set.regexp",
        "constant.other.character-class.regexp",
        "constant.other.character-class.set.regexp",
        "keyword.control.anchor.regexp",
        "keyword.operator.negation.regexp",
        "keyword.operator.or.regexp",
        "keyword.operator.quantifier.regexp",
        "punctuation.character.set.begin.regexp",
        "punctuation.character.set.end.regexp",
        "punctuation.definition.character-class.regexp",
        "punctuation.definition.group.assertion.regexp",
        "punctuation.definition.group.regexp",
        "support.other.parenthesis.regexp"
      ],
      "settings": {
        "foreground": "#D9753A"
      }
    },
    {
      "name": "Labels",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#E5D1AF"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F8F4EC",
        "background": "#D9753A"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#9C968A",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.json string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#E5D1AF"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#E5D1AF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.bold",
        "markup.italic"
      ],
      "settings": {
        "foreground": "#E5BF8D"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link.inline"
      ],
      "settings": {
        "foreground": "#93B1CC"
      }
    },
    {
      "name": "Markdown raw",
      "scope": [
        "markup.raw",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#93B1CC"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#BDD2E4"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#C86B34"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#E5BF8D"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#E5D1AF",
    "type": "#E5D1AF",
    "class": "#E5D1AF",
    "enum": "#E5D1AF",
