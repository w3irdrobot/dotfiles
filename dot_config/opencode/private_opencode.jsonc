{
  "$schema": "https://opencode.ai/config.json",
  "worktree": {
    "directory": ".worktrees"
  },
  "references": {
    "knowledge": {
      "path": "~/projects/github.com/w3irdrobot/knowledge-base",
      "description": "Personal developer decisions, verified workflows, research, and session handoffs. Consult relevant notes for environment setup and recurring workflows."
    }
  },
  "mcp": {
    "better-auth": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.better-auth.com/mcp"
    },
    "exa": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "{env:EXA_API_KEY}"
      }
    },
    "linear": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.linear.app/mcp"
    },
    "github": {
      "enabled": true,
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_MCP_TOKEN}"
      }
    }
  },
  "provider": {
    "maple-local": {
      "name": "Maple Local",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "headers": {
          "Authorization": "Bearer {env:MAPLE_API_KEY}"
        }
      },
      "models": {
        "glm-5-3-flash": {
          "name": "GLM-5.3 Flash"
        },
        "kimi-k3": {
          "name": "Kimi K3"
        }
      }
    }
  }
}
