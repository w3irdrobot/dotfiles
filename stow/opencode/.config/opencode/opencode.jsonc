{
  "$schema": "https://opencode.ai/config.json",
  "worktree": {
    "directory": ".worktrees"
  },
  "references": {
    "knowledge": {
      "path": "{env:HOME}/projects/github.com/w3irdrobot/knowledge-base",
      "description": "Personal developer decisions, verified workflows, research, and session handoffs. Consult relevant notes for environment setup and recurring workflows."
    }
  },
  "mcp": {
    "servers": {
      "better-auth": {
        "disabled": true,
        "type": "remote",
        "url": "https://mcp.better-auth.com/mcp"
      },
      "exa": {
        "disabled": false,
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp",
        "headers": {
          "x-api-key": "{env:EXA_API_KEY}"
        }
      },
      "linear": {
        "disabled": false,
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      },
      "github": {
        "disabled": false,
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "Authorization": "Bearer {env:GITHUB_TOKEN}"
        }
      }
    }
  },
  "providers": {
    "maple-local": {
      "name": "Maple Local",
      "package": "@opencode/ai/providers/openai-compatible",
      "headers": {
        "Authorization": "Bearer {env:MAPLE_API_KEY}"
      },
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "glm-5-3-flash": {
          "name": "GLM-5.3 Flash"
        },
        "deepseek-v4-1-flash": {
          "name": "DeepSeek V4.1 Flash"
        },
        "kimi-k3": {
          "name": "Kimi K3"
        }
      }
    }
  }
}
