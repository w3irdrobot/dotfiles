#!/usr/bin/env bash
set -euo pipefail

# secrets-import: Restore transitional GPG/SSH keys and Sparrow wallets from an encrypted archive

die() {
	echo "Error: $1" >&2
	exit 1
}

check_deps() {
	local missing=()
	for cmd in gpg fzf tar jq; do
		command -v "$cmd" &>/dev/null || missing+=("$cmd")
	done

	if [[ ${#missing[@]} -gt 0 ]]; then
		die "Missing required tools: ${missing[*]}"
	fi
}

list_removable_media() {
	# Output: JSON records; paths are never recovered from display text.
	case "$(uname -s)" in
	Linux)
		list_removable_media_linux
		;;
	Darwin)
		list_removable_media_macos
		;;
	*)
		die "Unsupported operating system"
		;;
	esac
}

list_removable_media_linux() {
	# NAME requests the lsblk tree. Children inherit their removable ancestry.
	# Buffer the whole result so a malformed node cannot yield partial candidates.
	lsblk -o NAME,MOUNTPOINT,LABEL,SIZE,HOTPLUG,RM -J | jq -cs '
		def devices($removable):
			if type != "object" then error("Invalid lsblk device") else . end
			| ($removable or .hotplug == true or .hotplug == 1 or .rm == true or .rm == 1) as $eligible
			| (if .mountpoint == null then empty
				elif (.mountpoint | type) != "string" then error("Invalid mountpoint")
				elif $eligible and (.mountpoint | test("^/(media|run/media)/")) then
					if (.mountpoint | test("[\\x00-\\x1f\\x7f]")) then error("Unsafe mountpoint control character")
					else {mountpoint, label: (.label // "Unlabeled"), size: (.size // "?")} end
				else empty end),
			((.children // []) | if type != "array" then error("Invalid lsblk children") else .[] | devices($eligible) end);
		if length != 1 or (.[0].blockdevices | type) != "array" then error("Invalid lsblk JSON") else .[0] end
		| [.blockdevices[] | devices(false)] | .[]
	'
}

list_removable_media_macos() {
	# List /Volumes/*, excluding the boot volume
	local boot_volume
	boot_volume=$(df / | tail -1 | awk '{print $NF}') || return

	for vol in /Volumes/*; do
		[[ ! -d "$vol" ]] && continue
		[[ "$vol" == "$boot_volume" ]] && continue
		# Skip Time Machine snapshots and system volumes
		[[ "$vol" == "/Volumes/Macintosh HD"* ]] && continue
		[[ "$vol" == "/Volumes/Recovery"* ]] && continue

		local label size
		[[ $vol != *[[:cntrl:]]* ]] || return 1
		label=${vol##*/}
		size=$(df -h "$vol" | tail -1 | awk '{print $2}') || return
		jq -cn --arg mountpoint "$vol" --arg label "$label" --arg size "$size" \
			'{mountpoint: $mountpoint, label: $label, size: $size}' || return
	done
}

select_removable_media() {
	local records rows selected id expected
	records=$(printf '%s\n' "$1" | jq -cse '
		if length > 0 and all(.[];
			(.mountpoint | type) == "string" and
			(.mountpoint | startswith("/")) and
			(.mountpoint | test("[\\x00-\\x1f\\x7f]") | not))
		then . else error("Invalid media records") end
	') || return 1
	# JSON-escape all display fields, including terminal controls and newlines.
	rows=$(printf '%s\n' "$records" | jq -r 'to_entries[] |
		"\(.key)\t\(.value.label | @json) (\(.value.size | @json)) - \(.value.mountpoint | @json)"') || return 1
	selected=$(printf '%s\n' "$rows" | fzf --prompt="$2" \
		--header="Removable Media" --height=40% --reverse \
		--delimiter=$'\t' --with-nth=2.. --no-multi) || return 1
	id=${selected%%$'\t'*}
	[[ $id =~ ^(0|[1-9][0-9]*)$ ]] || return 1
	expected=$(printf '%s\n' "$rows" | awk -F '\t' -v id="$id" '$1 == id { print }') || return 1
	[[ -n $expected && $selected == "$expected" ]] || return 1
	printf '%s\n' "$records" | jq -er --arg id "$id" '
		to_entries | map(select((.key | tostring) == $id)) |
		if length == 1 then .[0].value.mountpoint else error("Invalid media index") end'
}

list_archives() {
	local mount_point="$1"
	# List .tar.gz.gpg files, showing just the filename
	find "$mount_point" -maxdepth 1 -name '*.tar.gz.gpg' -type f -exec basename {} \; 2>/dev/null | sort -r
}

get_current_trust_level() {
	# Get current trust level for a key (returns: ultimate, full, marginal, never, unknown, or empty)
	local keyid="$1"
	gpg --list-keys --with-colons "$keyid" 2>/dev/null | awk -F: '/^pub/ {print $2}' | head -1
}

trust_level_name() {
	# Convert trust code to human-readable name
	case "$1" in
	u) echo "ultimate" ;;
	f) echo "full" ;;
	m) echo "marginal" ;;
	n) echo "never" ;;
	*) echo "unknown" ;;
	esac
}

prompt_trust_level() {
	local keyid="$1"
	local email="$2"
	local fingerprint

	fingerprint=$(gpg --list-keys --with-colons "$keyid" 2>/dev/null |
		awk -F: '/^fpr:/ { print $10; exit }')
	if [[ -z "$fingerprint" ]]; then
		printf '  Could not determine the fingerprint for %s; skipping trust setup.\n' "$keyid" >&2
		return 0
	fi

	# Check current trust level
	local current_trust
	current_trust=$(get_current_trust_level "$keyid")

	if [[ "$current_trust" == "u" || "$current_trust" == "f" ]]; then
		echo "  Trust level already set to $(trust_level_name "$current_trust"), skipping."
		return 0
	fi

	echo ""
	echo "Set trust level for: $email ($keyid)"
	echo "  1 = I don't know or won't say"
	echo "  2 = I do NOT trust"
	echo "  3 = I trust marginally"
	echo "  4 = I trust fully"
	echo "  5 = I trust ultimately"
	echo "  s = skip (don't set trust)"
	echo ""

	local choice
	while true; do
		read -rp "Your choice: " choice </dev/tty
		case "$choice" in
		[1-5])
			# Apply trust level using gpg --import-ownertrust
			# Ownertrust requires the full fingerprint, not the short key ID.
			# Trust levels: 2=unknown, 3=never, 4=marginal, 5=full, 6=ultimate
			local gpg_trust_level=$((choice + 1))
			printf '%s:%s:\n' "$fingerprint" "$gpg_trust_level" |
				gpg --import-ownertrust &>/dev/null
			echo "Trust level set."
			break
			;;
		[sS])
			echo "Skipping trust configuration."
			break
			;;
		*)
			echo "Invalid choice. Please enter 1-5 or 's' to skip."
			;;
		esac
	done
}

check_import_parents() {
	local parent
	parent=$(dirname "$1") || return 2
	while [[ $parent != "$HOME" && $parent != / ]]; do
		if [[ -L $parent || (-e $parent && ! -d $parent) ]]; then
			printf 'Conflicting import parent: %s\n' "$parent" >&2
			return 2
		fi
		parent=$(dirname "$parent") || return 2
	done
}

# Stage privately, then publish without ever replacing an existing destination.
import_new_file() (
	local src=$1 dest=$2 perms=$3 method=$4 scratch parent
	parent=$(dirname "$dest") || return 2
	scratch=$(mktemp -d "$parent/.secrets-import.XXXXXXXX") || return 2
	trap 'rm -rf -- "$scratch"' EXIT
	if [[ $method == install ]]; then
		install -m "$perms" "$src" "$scratch/file" || return 2
	else
		cp "$src" "$scratch/file" || return 2
		chmod "$perms" "$scratch/file" || return 2
	fi
	ln --no-target-directory -- "$scratch/file" "$dest" || return 2
)

# Key/wallet helpers return 0 for import, 1 for an existing-file skip, 2 for error.
# Callers must distinguish skips from errors; conditional calls disable errexit.
import_ssh_key() {
	local src="$1"
	local dest="$2"
	local keyname
	keyname=$(basename "$dest") || return 2
	check_import_parents "$dest" || return 2
	[[ -f $src && ! -L $src ]] || return 2
	if [[ -L $dest || (-e $dest && ! -f $dest) ]]; then
		printf 'Conflicting SSH key destination: %s\n' "$dest" >&2
		return 2
	fi

	# Explicit IdentityFile entries are private even when their names end in .pub.
	# Retain suffix-based permissions for legacy direct callers.
	local perms="600"
	case ${3:-} in
	private) ;;
	public) perms="644" ;;
	'') [[ "$keyname" != *.pub ]] || perms="644" ;;
	*) return 2 ;;
	esac

	if [[ ! -f "$dest" ]]; then
		# Key doesn't exist, copy it
		import_new_file "$src" "$dest" "$perms" cp || return 2
		echo "  Imported: $keyname"
		return 0
	fi

	# Key exists, compare
	if cmp -s "$src" "$dest"; then
		# Identical, skip
		echo "  Skipped: $keyname (already exists, identical)"
		return 1
	else
		local status=$?
		[[ $status == 1 ]] || return 2
		# Different, warn and skip
		echo "  Warning: $keyname exists and differs, skipping"
		return 1
	fi
}

# The flat legacy archive has no manifest. IdentityFile entries identify named
# keys; id_* remains supported for archives predating exported SSH config.
# Output: role<TAB>basename records; control characters in names are refused.
list_archive_ssh_keys() {
	local archive=$1 config="$1/ssh_config" line value name folded file
	local syntax='^[[:space:]]*[Ii][Dd][Ee][Nn][Tt][Ii][Tt][Yy][Ff][Ii][Ll][Ee][[:space:]=]+(.*)$'
	local quoted='^"([^"\\]*)"[[:space:]]*(#.*)?$'
	local plain='^([^[:space:]"\\]+)[[:space:]]*(#.*)?$'
	local -A names=() required=() owners=()
	if [[ -e $config || -L $config ]]; then
		[[ -f $config && ! -L $config ]] || return 2
		while IFS= read -r line || [[ -n $line ]]; do
			[[ $line =~ $syntax ]] || continue
			value=${BASH_REMATCH[1]}
			if [[ $value =~ $quoted || $value =~ $plain ]]; then
				value=${BASH_REMATCH[1]}
			else
				printf 'Unsupported archived SSH IdentityFile syntax.\n' >&2
				return 2
			fi
			[[ ${value,,} != none ]] || continue
			name=${value##*/}
			case ${name,,} in '' | . | .. | ssh_config | sparrow_wallets | gpg_*.asc)
				printf 'Reserved or invalid archived SSH key basename.\n' >&2
				return 2
				;;
			esac
			names["$name"]=1
			required["$name"]=1
			names["$name.pub"]=1
		done <"$config"
	fi
	for file in "$archive"/id_*; do
		[[ -e $file || -L $file ]] || continue
		names["${file##*/}"]=1
	done
	# Validate all candidates before returning any to the importing caller.
	for name in "${!names[@]}"; do
		# Names are returned as lines; never let an archive split one into paths.
		[[ $name != *[[:cntrl:]]* ]] || return 2
		file=$archive/$name
		if [[ ! -e $file && ! -L $file ]]; then
			if [[ ${required[$name]+present} ]]; then
				printf 'Missing archived SSH identity: %s\n' "$name" >&2
				return 2
			fi
			continue
		fi
		[[ -f $file && ! -L $file ]] || {
			printf 'Invalid archived SSH key file: %s\n' "$name" >&2
			return 2
		}
		folded=${name,,}
		if [[ ${owners[$folded]+present} && ${owners[$folded]} != "$name" ]]; then
			printf 'Archived SSH key basename collision.\n' >&2
			return 2
		fi
		owners[$folded]=$name
	done
	for name in "${owners[@]}"; do
		if [[ ${required[$name]+present} || $name != *.pub ]]; then
			printf 'private\t%s\n' "$name"
		else
			printf 'public\t%s\n' "$name"
		fi
	done
}

import_ssh_config() {
	local src="$1"
	local config="$HOME/.ssh/config" dest="$HOME/.ssh/config.local"
	local marker='# Managed by secrets_import; machine-local SSH hosts.'
	local hosts_imported=0
	local hosts_skipped=0
	local first_line src_hosts host block existing
	[[ -f $src && ! -L $src ]] || return 2
	check_import_parents "$dest" || return 2
	# The main config is read-only here, including when Stow manages its symlink.
	[[ -f $config ]] || {
		printf 'Install an SSH config including ~/.ssh/config.local first.\n' >&2
		return 2
	}
	if ! grep -Eq '^[[:space:]]*[Ii][Nn][Cc][Ll][Uu][Dd][Ee][[:space:]]+~/\.ssh/config\.local[[:space:]]*$' "$config"; then
		printf 'SSH config must include ~/.ssh/config.local; refusing to modify it.\n' >&2
		return 2
	fi
	if [[ -L $dest || (-e $dest && ! -f $dest) ]]; then
		printf 'Conflicting SSH config fragment: %s\n' "$dest" >&2
		return 2
	fi
	if [[ -e $dest ]]; then
		IFS= read -r first_line <"$dest" || return 2
		[[ $first_line == "$marker" ]] || {
			printf 'Unmanaged SSH config fragment: %s\n' "$dest" >&2
			return 2
		}
	else
		# Noclobber also refuses a destination which appeared since preflight.
		(
			umask 077
			set -o noclobber
			printf '%s\n' "$marker" >"$dest"
		) || return 2
	fi
	chmod 600 "$dest" || return 2
	# Import concrete host blocks only, never global defaults, patterns, or Match.
	src_hosts=$(awk 'tolower($1) == "host" && NF == 2 && $2 !~ /[*?!]/ { print $2 }' "$src") || return 2
	while IFS= read -r host; do
		[[ -n $host ]] || continue
		existing=$(awk -v host="$host" 'tolower($1) == "host" { for (i=2; i<=NF; i++) if (tolower($i) == tolower(host)) found=1 } END { print found+0 }' "$config" "$dest") || return 2
		if [[ $existing == 1 ]]; then
			hosts_skipped=$((hosts_skipped + 1))
			continue
		fi
		block=$(awk -v host="$host" '
			tolower($1) == "host" || tolower($1) == "match" {
				if (capture) exit
				capture = (tolower($1) == "host" && NF == 2 && $2 == host)
			}
			capture { print }
		' "$src") || return 2
		[[ -n $block ]] || return 2
		printf '\n%s\n' "$block" >>"$dest" || return 2
		hosts_imported=$((hosts_imported + 1))
	done <<<"$src_hosts"
	printf '%s:%s\n' "$hosts_imported" "$hosts_skipped"
}

cleanup() {
	if [[ -n "${TEMP_DIR:-}" && -d "$TEMP_DIR" ]]; then
		rm -rf "$TEMP_DIR"
	fi
}

import_sparrow_wallet() {
	local src="$1" dest="$2"
	local wallet_name="${dest##*/}"
	check_import_parents "$dest" || return 2
	[[ -f $src && ! -L $src ]] || return 2
	if [[ -L $dest || (-e $dest && ! -f $dest) ]]; then
		printf 'Conflicting wallet destination: %s\n' "$dest" >&2
		return 2
	fi

	if [[ -e "$dest" || -L "$dest" ]]; then
		if cmp -s "$src" "$dest"; then
			printf '  Skipped: %s (already exists, identical)\n' "$wallet_name"
		else
			local status=$?
			[[ $status == 1 ]] || return 2
			printf '  Warning: %s exists and differs; leaving it unchanged\n' "$wallet_name" >&2
		fi
		return 1
	fi

	import_new_file "$src" "$dest" 600 install || return 2
	printf '  Imported: %s\n' "$wallet_name"
}

main() {
	check_deps

	# Select removable media or fall back to current directory
	local media_list mount_point
	media_list=$(list_removable_media) || die "Cannot list removable media."
	if [[ -z "$media_list" ]]; then
		echo ""
		echo "No removable media found. Looking in current directory."
		mount_point="$(pwd)"
	else
		mount_point=$(select_removable_media "$media_list" "Select source media: ") || die "No valid media selected. Aborting."

		if [[ ! -d "$mount_point" || ! -r "$mount_point" ]]; then
			die "Cannot read from $mount_point"
		fi
	fi

	# List and select archive
	local archives
	archives=$(list_archives "$mount_point")
	if [[ -z "$archives" ]]; then
		die "No secret archives (.tar.gz.gpg) found on $mount_point"
	fi

	local selected_archive
	selected_archive=$(echo "$archives" |
		fzf --prompt="Select archive to import: " \
			--header="Secret Archives" \
			--height=40% \
			--reverse) || die "No archive selected. Aborting."

	local archive_path="$mount_point/$selected_archive"

	# Create temp directory with cleanup trap
	TEMP_DIR=$(mktemp -d)
	trap cleanup EXIT

	echo ""
	echo "Decrypting archive..."
	echo "You will be prompted for the archive passphrase."
	echo ""

	# Decrypt and extract
	gpg --decrypt "$archive_path" 2>/dev/null | tar xzf - -C "$TEMP_DIR"

	echo "Archive decrypted successfully."
	echo ""

	# Import GPG keys
	local gpg_count=0
	echo "Importing GPG keys..."
	for keyfile in "$TEMP_DIR"/gpg_*.asc; do
		[[ ! -f "$keyfile" ]] && continue

		# Extract keyid from filename (gpg_KEYID.asc)
		local keyid
		keyid=$(basename "$keyfile" | sed 's/^gpg_//; s/\.asc$//')

		echo "  Importing GPG key: $keyid"
		gpg --import "$keyfile" </dev/null 2>&1 | grep -E "^gpg:" | head -3 || true

		# Get email for this key
		local email
		email=$(gpg --list-keys "$keyid" 2>/dev/null | sed -n 's/.*<\([^>]*\)>.*/\1/p' | head -1)
		[[ -z "$email" ]] && email="unknown"

		prompt_trust_level "$keyid" "$email"
		gpg_count=$((gpg_count + 1))
		echo ""
	done

	if [[ $gpg_count -eq 0 ]]; then
		echo "  No GPG keys found in archive."
	fi

	# Import SSH keys
	local ssh_imported=0
	local ssh_skipped=0
	echo ""
	echo "Importing SSH keys..."

	# Ensure ~/.ssh exists with correct permissions
	check_import_parents "$HOME/.ssh/config" || die 'Unsafe SSH directory.'
	mkdir -p "$HOME/.ssh"
	chmod 700 "$HOME/.ssh"

	local ssh_key_names keyname keyrole
	ssh_key_names=$(list_archive_ssh_keys "$TEMP_DIR") || die 'Invalid archived SSH keys.'
	while IFS=$'\t' read -r keyrole keyname; do
		[[ -n $keyname ]] || continue
		keyfile="$TEMP_DIR/$keyname"
		local dest="$HOME/.ssh/$keyname"

		if import_ssh_key "$keyfile" "$dest" "$keyrole"; then
			ssh_imported=$((ssh_imported + 1))
		else
			local status=$?
			[[ $status == 1 ]] || die "Failed to import SSH key: $keyname"
			ssh_skipped=$((ssh_skipped + 1))
		fi
	done <<<"$ssh_key_names"

	if [[ $ssh_imported -eq 0 && $ssh_skipped -eq 0 ]]; then
		echo "  No SSH keys found in archive."
	fi

	# Import SSH config
	local ssh_config_imported=0
	local ssh_config_skipped=0
	echo ""
	echo "Importing SSH config..."

	if [[ -f "$TEMP_DIR/ssh_config" ]]; then
		local config_result
		config_result=$(import_ssh_config "$TEMP_DIR/ssh_config") || die 'Failed to import SSH config.'
		if [[ "$config_result" == *:* ]]; then
			ssh_config_imported=$(echo "$config_result" | cut -d: -f1)
			ssh_config_skipped=$(echo "$config_result" | cut -d: -f2)
		else
			ssh_config_imported=${config_result:-0}
		fi
	else
		echo "  No SSH config found in archive."
	fi

	# Restore the wallet files exported by secrets_export, without overwriting.
	local sparrow_imported=0 sparrow_skipped=0 wallet_file wallet_name
	if [[ -d "$TEMP_DIR/sparrow_wallets" ]]; then
		printf '\nImporting Sparrow wallets...\n'
		check_import_parents "$HOME/.sparrow/wallets/wallet" || die 'Unsafe wallet directory.'
		install -d -m0700 "$HOME/.sparrow/wallets"
		while IFS= read -r -d '' wallet_file; do
			wallet_name="${wallet_file##*/}"
			if import_sparrow_wallet "$wallet_file" "$HOME/.sparrow/wallets/$wallet_name"; then
				sparrow_imported=$((sparrow_imported + 1))
			else
				local status=$?
				[[ $status == 1 ]] || die "Failed to import wallet: $wallet_name"
				sparrow_skipped=$((sparrow_skipped + 1))
			fi
		done < <(find "$TEMP_DIR/sparrow_wallets" -maxdepth 1 -type f -print0)
	fi

	# Summary
	echo ""
	echo "Import complete:"
	echo "  - $gpg_count GPG key(s) imported"
	echo "  - $ssh_imported SSH key(s) imported"
	if [[ $ssh_skipped -gt 0 ]]; then
		echo "  - $ssh_skipped SSH key(s) skipped (already exist or differ)"
	fi
	if [[ $ssh_config_imported -gt 0 || $ssh_config_skipped -gt 0 ]]; then
		echo "  - $ssh_config_imported SSH config host(s) imported"
		if [[ $ssh_config_skipped -gt 0 ]]; then
			echo "  - $ssh_config_skipped SSH config host(s) skipped (already exist)"
		fi
	fi
	printf '  - %s Sparrow wallet(s) imported; %s skipped\n' "$sparrow_imported" "$sparrow_skipped"
}

main "$@"
