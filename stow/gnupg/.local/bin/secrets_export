#!/usr/bin/env bash
set -euo pipefail

# secrets-export: Export GPG keys, SSH keys, and Sparrow wallets to an encrypted archive

die() {
	echo "Error: $1" >&2
	exit 1
}

check_deps() {
	local missing=()
	for cmd in gpg fzf tar jq; do
		command -v "$cmd" &>/dev/null || missing+=("$cmd")
	done

	if [[ ${#missing[@]} -gt 0 ]]; then
		die "Missing required tools: ${missing[*]}"
	fi
}

list_gpg_keys() {
	# Output: "email|KEYID" per line
	gpg --list-secret-keys --with-colons --fixed-list-mode 2>/dev/null |
		awk -F: '
            /^sec/ { key = $5 }
            /^uid/ && key {
                email = $10
                if (email ~ /<[^>]+>/) {
                    sub(/^.*</, "", email)
                    sub(/>.*/, "", email)
                    print email "|" key
                    key = ""
                }
            }
        ' | sort -u
}

ssh_config_content() {
	# Follow only the documented local fragment, in place. Never evaluate config
	# commands or silently ignore other includes in a purported complete backup.
	local file=${1:-$HOME/.ssh/config} section_seen=0 line directive rest
	local syntax='^[[:space:]]*([^[:space:]=]+)[[:space:]]*=?[[:space:]]*(.*)$'
	[[ -f $file ]] || return 0
	while IFS= read -r line || [[ -n $line ]]; do
		[[ $line =~ ^[[:space:]]*(#|$) ]] && continue
		[[ $line =~ $syntax ]] || {
			printf 'Unsupported SSH syntax in %s.\n' "$file" >&2
			return 1
		}
		directive=${BASH_REMATCH[1],,} rest=${BASH_REMATCH[2]}
		case $directive in
		include)
			rest=$(ssh_single_argument "$rest") || return
			if [[ $file != "$HOME/.ssh/config" || $section_seen == 1 || $rest != \~/.ssh/config.local ]]; then
				printf 'Unsupported SSH Include in %s; review and flatten it before exporting.\n' "$file" >&2
				return 1
			fi
			ssh_config_content "$HOME/.ssh/config.local" || return
			# An included file can change the active Host/Match context.
			section_seen=1
			;;
		match)
			rest=$(ssh_single_argument "$rest") || return
			[[ ${rest,,} == all ]] || {
				printf 'Unsupported SSH Match condition; flatten it before exporting (commands are never executed).\n' >&2
				return 1
			}
			section_seen=1
			printf 'match all\n'
			;;
		host)
			# Only OpenSSH glob patterns, not shell quoting/extended globs.
			[[ $rest != *[\"\\]* ]] || {
				printf 'Unsupported quoted/escaped SSH Host patterns.\n' >&2
				return 1
			}
			section_seen=1
			printf 'host %s\n' "$rest"
			;;
		canonicalizehostname)
			rest=$(ssh_single_argument "$rest") || return
			[[ ${rest,,} == no ]] || {
				printf 'SSH hostname canonicalization is unsupported; flatten the config before exporting.\n' >&2
				return 1
			}
			printf 'canonicalizehostname no\n'
			;;
		*) printf '%s %s\n' "$directive" "$rest" ;;
		esac
	done <"$file"
}

ssh_single_argument() {
	# Parse one value without eval, expansion, or config execution. Fail closed on
	# escapes/extra arguments rather than guess at a filename or Include target.
	local quoted='^"([^"\\]*)"[[:space:]]*(#.*)?$'
	local plain='^([^[:space:]"\\]+)[[:space:]]*(#.*)?$'
	if [[ $1 =~ $quoted || $1 =~ $plain ]]; then
		printf '%s\n' "${BASH_REMATCH[1]}"
	else
		printf 'Unsupported SSH argument syntax; simplify quoting/escapes before exporting.\n' >&2
		return 1
	fi
}

list_ssh_config_hosts() {
	# Concrete aliases only, including multiple aliases on one Host line.
	ssh_config_content | awk '
		tolower($1) == "host" {
			for (i=2; i<=NF && $i !~ /^#/; i++)
				if ($i !~ /[*?!]/) print $i
		}' | sort -u
}

list_sparrow_wallets() {
	local wallets_dir="$HOME/.sparrow/wallets"
	if [[ -d "$wallets_dir" ]]; then
		find "$wallets_dir" -maxdepth 1 -type f -exec basename {} \; | sort
	fi
}

extract_ssh_config_host() {
	# Flatten all applicable blocks in original order. This preserves first-value
	# options and accumulating IdentityFile entries without ssh -G / Match exec.
	local host="$1"
	ssh_config_content | awk -v host="$host" '
		function matches(pattern, value,    regex, i, c) {
			regex="^"
			for (i=1; i<=length(pattern); i++) {
				c=substr(pattern,i,1)
				if (c == "*") regex=regex ".*"
				else if (c == "?") regex=regex "."
				else {
					if (index(".[](){}+^$|\\", c)) regex=regex "\\"
					regex=regex c
				}
			}
			# OpenSSH lowercases the requested hostname, not Host patterns.
			return tolower(value) ~ (regex "$")
		}
		BEGIN { active=1; host=tolower(host); print "Host " host }
		$1 == "host" {
			positive=0; negative=0
			for (i=2; i<=NF && $i !~ /^#/; i++) {
				pattern=$i
				if (substr(pattern,1,1) == "!") {
					if (matches(substr(pattern,2), host)) negative=1
				} else if (matches(pattern,host)) positive=1
			}
			active=positive && !negative
			next
		}
		$1 == "match" { active=1; next }
		active { print }
	'
}

get_identity_file_for_host() {
	# Every explicit identity in all applicable contexts, without shell eval.
	local host="$1"
	local identity_file
	local identities
	identities=$(extract_ssh_config_host "$host" | awk '$1 == "identityfile" { sub(/^[^[:space:]]+[[:space:]]+/, ""); print }') || return
	while IFS= read -r identity_file; do
		[[ -n $identity_file ]] || continue
		identity_file=$(ssh_single_argument "$identity_file") || return
		[[ ${identity_file,,} != none ]] || continue
		[[ $identity_file != *['%$']* && ($identity_file != \~* || $identity_file == \~/*) ]] || {
			printf 'Unsupported SSH IdentityFile expansion; use a literal path before exporting.\n' >&2
			return 1
		}
		identity_file=${identity_file/#\~\//$HOME/}
		[[ $identity_file == /* ]] || {
			printf 'Unsupported SSH relative IdentityFile; use an absolute or ~/ path before exporting.\n' >&2
			return 1
		}
		printf '%s\n' "$identity_file"
	done <<<"$identities"
}

add_ssh_archive_source() {
	# Add one flat archive entry, refusing to let a later identity silently
	# replace an earlier file with the same basename. Reads and writes main()'s
	# associative arrays through Bash's dynamic scope.
	local name=$1 source=$2 role=$3
	if [[ -v ssh_archive_sources[$name] ]]; then
		[[ ${ssh_archive_sources[$name]} == "$source" ]] || {
			printf 'SSH key basename collision: %s. Rename the keys and update IdentityFile before exporting.\n' "$name" >&2
			return 1
		}
		return 0
	fi
	ssh_archive_sources[$name]=$source
	ssh_archive_roles[$name]=$role
}

preflight_ssh_archive_sources() {
	# The archive/import format is flat. Refuse collisions and reserved archive
	# entries before any key or archive is written. Reads main()'s associative
	# arrays through Bash's dynamic scope.
	local name source folded
	local -A owners=()
	for name in "${!ssh_archive_sources[@]}"; do
		source=${ssh_archive_sources[$name]}
		# Also safe on case-insensitive staging filesystems.
		folded=${name,,}
		case $folded in '' | . | .. | ssh_config | sparrow_wallets | gpg_*.asc)
			printf 'Reserved SSH key basename: %s\n' "$name" >&2
			return 1
			;;
		esac
		if [[ ${owners[$folded]+present} && ${owners[$folded]} != "$source" ]]; then
			printf 'SSH key basename collision: %s. Rename the keys and update IdentityFile before exporting.\n' "$name" >&2
			return 1
		fi
		owners[$folded]=$source
	done
}

list_removable_media() {
	# Output: JSON records; paths are never recovered from display text.
	case "$(uname -s)" in
	Linux)
		list_removable_media_linux
		;;
	Darwin)
		list_removable_media_macos
		;;
	*)
		die "Unsupported operating system"
		;;
	esac
}

list_removable_media_linux() {
	# NAME requests the lsblk tree. Children inherit their removable ancestry.
	# Buffer the whole result so a malformed node cannot yield partial candidates.
	lsblk -o NAME,MOUNTPOINT,LABEL,SIZE,HOTPLUG,RM -J | jq -cs '
		def devices($removable):
			if type != "object" then error("Invalid lsblk device") else . end
			| ($removable or .hotplug == true or .hotplug == 1 or .rm == true or .rm == 1) as $eligible
			| (if .mountpoint == null then empty
				elif (.mountpoint | type) != "string" then error("Invalid mountpoint")
				elif $eligible and (.mountpoint | test("^/(media|run/media)/")) then
					if (.mountpoint | test("[\\x00-\\x1f\\x7f]")) then error("Unsafe mountpoint control character")
					else {mountpoint, label: (.label // "Unlabeled"), size: (.size // "?")} end
				else empty end),
			((.children // []) | if type != "array" then error("Invalid lsblk children") else .[] | devices($eligible) end);
		if length != 1 or (.[0].blockdevices | type) != "array" then error("Invalid lsblk JSON") else .[0] end
		| [.blockdevices[] | devices(false)] | .[]
	'
}

list_removable_media_macos() {
	# List /Volumes/*, excluding the boot volume
	local boot_volume
	boot_volume=$(df / | tail -1 | awk '{print $NF}') || return

	for vol in /Volumes/*; do
		[[ ! -d "$vol" ]] && continue
		[[ "$vol" == "$boot_volume" ]] && continue
		# Skip Time Machine snapshots and system volumes
		[[ "$vol" == "/Volumes/Macintosh HD"* ]] && continue
		[[ "$vol" == "/Volumes/Recovery"* ]] && continue

		local label size
		[[ $vol != *[[:cntrl:]]* ]] || return 1
		label=${vol##*/}
		size=$(df -h "$vol" | tail -1 | awk '{print $2}') || return
		jq -cn --arg mountpoint "$vol" --arg label "$label" --arg size "$size" \
			'{mountpoint: $mountpoint, label: $label, size: $size}' || return
	done
}

select_removable_media() {
	local records rows selected id expected
	records=$(printf '%s\n' "$1" | jq -cse '
		if length > 0 and all(.[];
			(.mountpoint | type) == "string" and
			(.mountpoint | startswith("/")) and
			(.mountpoint | test("[\\x00-\\x1f\\x7f]") | not))
		then . else error("Invalid media records") end
	') || return 1
	# JSON-escape all display fields, including terminal controls and newlines.
	rows=$(printf '%s\n' "$records" | jq -r 'to_entries[] |
		"\(.key)\t\(.value.label | @json) (\(.value.size | @json)) - \(.value.mountpoint | @json)"') || return 1
	selected=$(printf '%s\n' "$rows" | fzf --prompt="$2" \
		--header="Removable Media" --height=40% --reverse \
		--delimiter=$'\t' --with-nth=2.. --no-multi) || return 1
	id=${selected%%$'\t'*}
	[[ $id =~ ^(0|[1-9][0-9]*)$ ]] || return 1
	expected=$(printf '%s\n' "$rows" | awk -F '\t' -v id="$id" '$1 == id { print }') || return 1
	[[ -n $expected && $selected == "$expected" ]] || return 1
	printf '%s\n' "$records" | jq -er --arg id "$id" '
		to_entries | map(select((.key | tostring) == $id)) |
		if length == 1 then .[0].value.mountpoint else error("Invalid media index") end'
}

cleanup() {
	if [[ -n "${TEMP_DIR:-}" && -d "$TEMP_DIR" ]]; then
		rm -rf "$TEMP_DIR"
	fi
}

select_export_items() {
	local choices=$1 prompt=$2 header=$3 selection status item
	# Expanded by fzf's action shell, not by this parent shell.
	# shellcheck disable=SC2016
	local enter_binding='enter:transform:if [ "${FZF_SELECT_COUNT:-0}" -gt 0 ]; then printf accept; else printf abort; fi'
	# fzf normally accepts the focused row when no rows are marked. This flow
	# requires explicit TAB selections; Enter with zero marks skips the category.
	# Ignore personal auto-select/output-transform options for secret selection.
	if selection=$(printf '%s\n' "$choices" |
		FZF_DEFAULT_OPTS='' FZF_DEFAULT_OPTS_FILE=/dev/null fzf --multi \
			--bind "$enter_binding" \
			--prompt="$prompt" --header="$header" --height=40% --reverse); then
		[[ -n $selection ]] || return 0
		while IFS= read -r item; do
			if [[ -z $item ]] || ! grep -Fxq -- "$item" <<<"$choices"; then
				printf 'Invalid export selection; refusing to export.\n' >&2
				return 2
			fi
		done <<<"$selection"
		printf '%s\n' "$selection"
	else
		status=$?
		case $status in
		1 | 130) return 0 ;;
		*)
			printf 'Export picker failed (exit %s); nothing exported.\n' "$status" >&2
			return "$status"
			;;
		esac
	fi
}

validate_selected_gpg_key() {
	local entry=$1 email keyid
	[[ $entry == *'|'* ]] || die 'Invalid selected GPG key record; refusing export.'
	email=${entry%%|*}
	keyid=${entry#*|}
	[[ -n $email && $keyid =~ ^([[:xdigit:]]{16}|[[:xdigit:]]{40}|[[:xdigit:]]{64})$ ]] || die 'Invalid or empty selected GPG key ID; refusing export.'
}

main() {
	check_deps

	# Select GPG keys
	local gpg_keys_raw selected_gpg_keys=()
	gpg_keys_raw=$(list_gpg_keys)
	if [[ -n "$gpg_keys_raw" ]]; then
		local gpg_selection
		gpg_selection=$(select_export_items "$gpg_keys_raw" \
			'Select GPG keys (TAB to mark; ENTER exports marks, none skips): ' \
			'GPG Secret Keys — TAB to mark; ENTER with no marks or ESC skips') || die 'Could not select GPG keys safely.'
		if [[ -n "$gpg_selection" ]]; then
			while IFS= read -r line; do
				validate_selected_gpg_key "$line"
				selected_gpg_keys+=("$line")
			done <<<"$gpg_selection"
		fi
	else
		echo "No GPG secret keys found."
	fi

	# Select SSH config hosts
	local ssh_hosts_raw selected_ssh_hosts=()
	ssh_hosts_raw=$(list_ssh_config_hosts)
	if [[ -n "$ssh_hosts_raw" ]]; then
		local ssh_hosts_selection
		ssh_hosts_selection=$(select_export_items "$ssh_hosts_raw" \
			'Select SSH hosts (TAB to mark; ENTER exports marks, none skips): ' \
			'SSH Hosts — only marked hosts and their identities/config are exported') || die 'Could not select SSH hosts safely.'
		if [[ -n "$ssh_hosts_selection" ]]; then
			while IFS= read -r line; do
				selected_ssh_hosts+=("$line")
			done <<<"$ssh_hosts_selection"
		fi
	else
		echo "No SSH config hosts found in ~/.ssh/config or its local fragment"
	fi

	# Select Sparrow wallets
	local sparrow_wallets_raw selected_sparrow_wallets=()
	sparrow_wallets_raw=$(list_sparrow_wallets)
	if [[ -n "$sparrow_wallets_raw" ]]; then
		local sparrow_wallets_selection
		sparrow_wallets_selection=$(select_export_items "$sparrow_wallets_raw" \
			'Select wallets (TAB to mark; ENTER exports marks, none skips): ' \
			'Sparrow Wallets — TAB to mark; ENTER with no marks or ESC skips') || die 'Could not select Sparrow wallets safely.'
		if [[ -n "$sparrow_wallets_selection" ]]; then
			while IFS= read -r line; do
				selected_sparrow_wallets+=("$line")
			done <<<"$sparrow_wallets_selection"
		fi
	else
		echo "No Sparrow wallets found in ~/.sparrow/wallets"
	fi

	# Derive SSH keys from selected hosts. With Bitwarden's SSH agent, private
	# keys normally live in the vault and only their .pub companions are on disk.
	# Accept either half here; the archive mapping below fails only when both are
	# absent.
	declare -A ssh_keys_map=() # Use associative array to dedupe
	for host in "${selected_ssh_hosts[@]}"; do
		local identity_file identities
		identities=$(get_identity_file_for_host "$host") || die "Could not parse SSH identities for $host."
		while IFS= read -r identity_file; do
			[[ -n $identity_file ]] || continue
			ssh_keys_map["$identity_file"]=1
		done <<<"$identities"
	done
	local selected_ssh_keys=("${!ssh_keys_map[@]}")

	# Map flat archive basenames to the files actually present. A selected
	# private key carries its public companion; an explicit public identity
	# stays public; an agent-only private path falls back to its .pub file.
	local -A ssh_archive_sources=() ssh_archive_roles=()
	local keypath keyname
	for keypath in "${selected_ssh_keys[@]}"; do
		keyname=${keypath##*/}
		if [[ $keypath == *.pub ]]; then
			[[ -f $keypath ]] || die "Missing selected SSH public identity: $keypath"
			add_ssh_archive_source "$keyname" "$keypath" public
		elif [[ -f $keypath ]]; then
			add_ssh_archive_source "$keyname" "$keypath" private
			if [[ -f ${keypath}.pub ]]; then
				add_ssh_archive_source "${keyname}.pub" "${keypath}.pub" public
			fi
		elif [[ -f ${keypath}.pub ]]; then
			# Agent-only identity: the private half stays in Bitwarden.
			add_ssh_archive_source "${keyname}.pub" "${keypath}.pub" public
		else
			die "Missing selected SSH identity: $keypath (no private key or public companion)"
		fi
	done
	preflight_ssh_archive_sources

	# Check if anything was selected
	if [[ ${#selected_gpg_keys[@]} -eq 0 && ${#selected_ssh_hosts[@]} -eq 0 && ${#selected_sparrow_wallets[@]} -eq 0 ]]; then
		die "Nothing selected. Aborting."
	fi

	local ssh_private_count=0 ssh_public_count=0 archive_name
	for archive_name in "${!ssh_archive_roles[@]}"; do
		if [[ ${ssh_archive_roles[$archive_name]} == private ]]; then
			ssh_private_count=$((ssh_private_count + 1))
		else
			ssh_public_count=$((ssh_public_count + 1))
		fi
	done

	echo ""
	echo "Selected ${#selected_gpg_keys[@]} GPG key(s), ${#selected_ssh_hosts[@]} SSH config host(s) (${ssh_private_count} private and ${ssh_public_count} public SSH key file(s)), and ${#selected_sparrow_wallets[@]} Sparrow wallet(s)."

	# Select removable media or fall back to current directory
	local media_list mount_point
	media_list=$(list_removable_media) || die "Cannot list removable media."
	if [[ -z "$media_list" ]]; then
		echo ""
		echo "No removable media found. Saving to current directory."
		mount_point="$(pwd)"
	else
		mount_point=$(select_removable_media "$media_list" "Select destination media: ") || die "No valid media selected. Aborting."

		if [[ ! -d "$mount_point" || ! -w "$mount_point" ]]; then
			die "Cannot write to $mount_point"
		fi
	fi

	# Check for existing archive
	local archive_name archive_path
	archive_name="secrets-$(date +%Y-%m-%d).tar.gz.gpg"
	archive_path="$mount_point/$archive_name"

	if [[ -f "$archive_path" ]]; then
		echo ""
		read -rp "Archive $archive_name already exists. Overwrite? [y/N] " confirm
		if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
			die "Aborted by user."
		fi
	fi

	# Create temp directory with cleanup trap
	TEMP_DIR=$(mktemp -d)
	trap cleanup EXIT

	echo ""
	echo "Exporting keys..."

	# Export GPG keys
	for entry in "${selected_gpg_keys[@]}"; do
		local email keyid
		validate_selected_gpg_key "$entry"
		email=${entry%%|*}
		keyid=${entry#*|}
		echo "  GPG: $email ($keyid)"
		gpg --export-secret-keys --armor "$keyid" >"$TEMP_DIR/gpg_${keyid}.asc"
	done

	# Copy SSH material (derived from selected hosts). An agent-only identity
	# contributes only its .pub file; the private key stays in Bitwarden.
	for archive_name in "${!ssh_archive_sources[@]}"; do
		echo "  SSH ${ssh_archive_roles[$archive_name]}: $archive_name"
		cp -- "${ssh_archive_sources[$archive_name]}" "$TEMP_DIR/$archive_name"
	done

	# Each selected host gets its complete applicable config, including globals.
	if [[ ${#selected_ssh_hosts[@]} -gt 0 ]]; then
		local ssh_config_file="$TEMP_DIR/ssh_config"
		: >"$ssh_config_file"
		for host in "${selected_ssh_hosts[@]}"; do
			echo "  SSH config: $host"
			echo "" >>"$ssh_config_file"
			extract_ssh_config_host "$host" >>"$ssh_config_file"
		done
	fi

	# Copy Sparrow wallets
	if [[ ${#selected_sparrow_wallets[@]} -gt 0 ]]; then
		local sparrow_export_dir="$TEMP_DIR/sparrow_wallets"
		mkdir -p "$sparrow_export_dir"
		for wallet in "${selected_sparrow_wallets[@]}"; do
			echo "  Sparrow wallet: $wallet"
			cp "$HOME/.sparrow/wallets/$wallet" "$sparrow_export_dir/"
		done
	fi

	# Create encrypted archive
	echo ""
	echo "Creating encrypted archive..."
	echo "You will be prompted for a passphrase to encrypt the archive."
	echo ""

	tar czf - -C "$TEMP_DIR" . | gpg --symmetric --cipher-algo AES256 -o "$archive_path"

	echo ""
	echo "Successfully exported to: $archive_path"
	echo ""
	echo "Contents:"
	echo "  - ${#selected_gpg_keys[@]} GPG key(s)"
	echo "  - $ssh_private_count SSH private key file(s)"
	if ((ssh_public_count > 0)); then
		echo "  - $ssh_public_count SSH public key file(s) (private halves stay in the agent/vault)"
	fi
	if [[ ${#selected_ssh_hosts[@]} -gt 0 ]]; then
		echo "  - ${#selected_ssh_hosts[@]} SSH config host(s) (+ global config)"
	fi
	echo "  - ${#selected_sparrow_wallets[@]} Sparrow wallet(s)"
}

main "$@"
