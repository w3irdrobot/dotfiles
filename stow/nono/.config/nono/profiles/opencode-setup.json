{
  "extends": "opencode-base",
  "meta": {
    "name": "opencode-setup",
    "version": "1.0.9",
    "description": "Maintain local shell configuration and developer tooling"
  },
  "filesystem": {
    "allow": [
      "$HOME/projects/github.com/w3irdrobot",
      "$HOME/.local/bin"
    ],
    "read": [
      "$HOME/.config/VSCodium/User",
      "$HOME/.config/bat",
      "$HOME/.config/ghostty",
      "$HOME/.config/k9s",
      "$HOME/.config/lazygit",
       "$HOME/.vscode-oss/extensions/w3irdrobot.kestrel-theme-0.0.1"
    ],
    "read_file": [
      "$HOME/.bash_profile",
      "$HOME/.vimrc",
      "$HOME/CLAUDE.md",
      "$HOME/.electrs/config.toml",
      "$HOME/.kube/kubie.yaml",
       "$HOME/.local/share/wallpapers/dracula-mnt-6272a4.png"
    ],
    "allow_file": [
      "$HOME/.bashrc",
      "$HOME/.profile"
    ],
    "bypass_protection": [
      "$HOME/.bashrc",
      "$HOME/.bash_profile",
      "$HOME/.profile",
      "$HOME/.kube/kubie.yaml"
    ]
  }
}
