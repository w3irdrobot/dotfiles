{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

install_root="${HOME}/.local/bin"
temp_dir="$(mktemp -d)"
trap 'rm -rf "$temp_dir"' EXIT
mkdir -p "$install_root"

{{ include ".chezmoitemplates/upstream-tools.sh" }}

download() {
    local url="$1"
    local destination="$2"
    curl --proto '=https' --tlsv1.2 -fsSL "$url" -o "$destination"
}

verify_sha256() {
    local path="$1"
    local expected="$2"
    printf '%s  %s\n' "$expected" "$path" | sha256sum --check
}

verify_manifest() {
    local archive="$1"
    local manifest="$2"

    (
        cd "$(dirname "$archive")"
        awk -v asset="$(basename "$archive")" '$2 == asset || $2 == "*" asset' "$manifest" |
            sha256sum --check
    )
}

verify_upstream_manifest() {
    local archive="$1"
    local manifest_url="$2"
    local manifest="${temp_dir}/$(basename "$manifest_url")"

    download "$manifest_url" "$manifest"
    verify_manifest "$archive" "$manifest"
}

install_tar_binary() {
    local command_name="$1"
    local version="$2"
    local url="$3"
    local manifest_url="$4"
    local member="$5"
    local archive="${temp_dir}/${command_name}-${version}.tar.gz"
    local extract_dir="${temp_dir}/${command_name}-${version}"

    if command -v "$command_name" >/dev/null 2>&1 && \
        "$command_name" --version 2>&1 | grep -Fq "$version"; then
        printf '%s %s already installed.\n' "$command_name" "$version"
        return
    fi

    printf 'Installing %s %s...\n' "$command_name" "$version"
    download "$url" "$archive"
    verify_upstream_manifest "$archive" "$manifest_url"
    mkdir -p "$extract_dir"
    tar -xzf "$archive" -C "$extract_dir"
    install -m0755 "${extract_dir}/${member}" "${install_root}/${command_name}"
}

printf 'Installing pinned upstream tools...\n'

install_tar_binary \
    fzf \
    "$fzf_version" \
    "https://github.com/junegunn/fzf/releases/download/v${fzf_version}/fzf-${fzf_version}-linux_amd64.tar.gz" \
    "https://github.com/junegunn/fzf/releases/download/v${fzf_version}/fzf_${fzf_version}_checksums.txt" \
    fzf

if command -v difft >/dev/null 2>&1 && difft --version 2>&1 | grep -Fq "$difft_version"; then
    printf 'difft %s already installed.\n' "$difft_version"
else
    printf 'Installing difft %s...\n' "$difft_version"
    difft_archive="${temp_dir}/difft-x86_64-unknown-linux-gnu.tar.gz"
    difft_extract_dir="${temp_dir}/difft-${difft_version}"
    download \
        "https://github.com/Wilfred/difftastic/releases/download/${difft_version}/$(basename "$difft_archive")" \
        "$difft_archive"
    verify_sha256 "$difft_archive" "$difft_sha256"
    mkdir -p "$difft_extract_dir"
    tar -xzf "$difft_archive" -C "$difft_extract_dir"
    install -m0755 "${difft_extract_dir}/difft" "${install_root}/difft"
fi

install_tar_binary \
    lazygit \
    "$lazygit_version" \
    "https://github.com/jesseduffield/lazygit/releases/download/v${lazygit_version}/lazygit_${lazygit_version}_linux_x86_64.tar.gz" \
    "https://github.com/jesseduffield/lazygit/releases/download/v${lazygit_version}/checksums.txt" \
    lazygit

opencode_archive="${temp_dir}/opencode-linux-x64.tar.gz"
if command -v opencode >/dev/null 2>&1 && opencode --version 2>&1 | grep -Fq "$opencode_version"; then
    printf 'opencode %s already installed.\n' "$opencode_version"
else
    printf 'Installing opencode %s...\n' "$opencode_version"
    download \
        "https://github.com/anomalyco/opencode/releases/download/v${opencode_version}/$(basename "$opencode_archive")" \
        "$opencode_archive"
    verify_sha256 "$opencode_archive" "$opencode_sha256"
    tar -xzf "$opencode_archive" -C "$temp_dir"
    install -m0755 "${temp_dir}/opencode" "${install_root}/opencode"
fi

if command -v nono >/dev/null 2>&1 && \
    nono --version 2>&1 | grep -Fq "$nono_version"; then
    printf 'nono %s already installed.\n' "$nono_version"
else
    printf 'Installing nono %s...\n' "$nono_version"
    nono_package="${temp_dir}/nono-cli_${nono_version}_amd64.deb"
    download \
        "https://github.com/nolabs-ai/nono/releases/download/v${nono_version}/nono-cli_${nono_version}_amd64.deb" \
        "$nono_package"
    verify_upstream_manifest \
        "$nono_package" \
        "https://github.com/nolabs-ai/nono/releases/download/v${nono_version}/SHA256SUMS.txt"
    sudo apt-get install --yes --no-install-recommends "$nono_package"
fi

if dpkg-query -W -f='${Version}' sparrowwallet 2>/dev/null |
    grep -Fq "${sparrow_version}-1"; then
    printf 'Sparrow Wallet %s already installed.\n' "$sparrow_version"
else
    printf 'Installing Sparrow Wallet %s...\n' "$sparrow_version"
    sparrow_package="${temp_dir}/sparrowwallet_${sparrow_version}-1_amd64.deb"
    sparrow_manifest="${temp_dir}/sparrow-${sparrow_version}-manifest.txt"
    sparrow_signature="${sparrow_manifest}.asc"
    sparrow_keyring="${temp_dir}/sparrow-keyring.gpg"
    sparrow_release_url="https://github.com/sparrowwallet/sparrow/releases/download/${sparrow_version}"

    download "${sparrow_release_url}/$(basename "$sparrow_package")" "$sparrow_package"
    download "${sparrow_release_url}/$(basename "$sparrow_manifest")" "$sparrow_manifest"
    download "${sparrow_release_url}/$(basename "$sparrow_signature")" "$sparrow_signature"
    download "https://keybase.io/craigraw/pgp_keys.asc" "${temp_dir}/craigraw.asc"

    gpg --batch --no-default-keyring --keyring "$sparrow_keyring" \
        --import "${temp_dir}/craigraw.asc"
    sparrow_fingerprint="$(
        gpg --batch --no-default-keyring --keyring "$sparrow_keyring" \
            --with-colons --fingerprint |
            awk -F: '$1 == "fpr" { print $10; exit }'
    )"
    if [[ "$sparrow_fingerprint" != "D4D0D3202FC06849A257B38DE94618334C674B40" ]]; then
        printf 'Sparrow Wallet signing key fingerprint mismatch.\n' >&2
        exit 1
    fi
    gpgv --keyring "$sparrow_keyring" "$sparrow_signature" "$sparrow_manifest"
    verify_manifest "$sparrow_package" "$sparrow_manifest"
    sudo apt-get install --yes --no-install-recommends "$sparrow_package"
fi

if command -v bitcoind >/dev/null 2>&1 && \
    bitcoind --version 2>&1 | grep -Fq "$bitcoin_version"; then
    printf 'Bitcoin Core %s already installed.\n' "$bitcoin_version"
else
    printf 'Installing Bitcoin Core %s...\n' "$bitcoin_version"
    bitcoin_archive="${temp_dir}/bitcoin-${bitcoin_version}-x86_64-linux-gnu.tar.gz"
    bitcoin_extract_dir="${temp_dir}/bitcoin-${bitcoin_version}"
    download \
        "https://bitcoincore.org/bin/bitcoin-core-${bitcoin_version}/bitcoin-${bitcoin_version}-x86_64-linux-gnu.tar.gz" \
        "$bitcoin_archive"
    verify_upstream_manifest \
        "$bitcoin_archive" \
        "https://bitcoincore.org/bin/bitcoin-core-${bitcoin_version}/SHA256SUMS"
    mkdir -p "$bitcoin_extract_dir"
    tar -xzf "$bitcoin_archive" --strip-components=1 -C "$bitcoin_extract_dir"
    install -m0755 "${bitcoin_extract_dir}/bin/bitcoind" "${install_root}/bitcoind"
    install -m0755 "${bitcoin_extract_dir}/bin/bitcoin-cli" "${install_root}/bitcoin-cli"
fi

{{ if .install_kubernetes_tools -}}
install_tar_binary \
    k9s \
    "$k9s_version" \
    "https://github.com/derailed/k9s/releases/download/v${k9s_version}/k9s_Linux_amd64.tar.gz" \
    "https://github.com/derailed/k9s/releases/download/v${k9s_version}/checksums.sha256" \
    k9s

helm_archive="${temp_dir}/helm-v${helm_version}-linux-amd64.tar.gz"
if command -v helm >/dev/null 2>&1 && helm version --short 2>&1 | grep -Fq "$helm_version"; then
    printf 'helm %s already installed.\n' "$helm_version"
else
    printf 'Installing helm %s...\n' "$helm_version"
    download "https://get.helm.sh/$(basename "$helm_archive")" "$helm_archive"
    download "https://get.helm.sh/$(basename "$helm_archive").sha256" "${helm_archive}.sha256"
    printf '%s  %s\n' "$(< "${helm_archive}.sha256")" "$helm_archive" | sha256sum --check
    tar -xzf "$helm_archive" -C "$temp_dir"
    install -m0755 "${temp_dir}/linux-amd64/helm" "${install_root}/helm"
fi
{{ end -}}

font_dir="${HOME}/.local/share/fonts/JetBrainsMono"
if [[ ! -f "${font_dir}/.nerd-font-version" ]] || \
    [[ "$(< "${font_dir}/.nerd-font-version")" != "$font_version" ]]; then
    printf 'Installing JetBrainsMono Nerd Font %s...\n' "$font_version"
    font_archive="${temp_dir}/JetBrainsMono.zip"
    download \
        "https://github.com/ryanoasis/nerd-fonts/releases/download/v${font_version}/JetBrainsMono.zip" \
        "$font_archive"
    verify_upstream_manifest \
        "$font_archive" \
        "https://github.com/ryanoasis/nerd-fonts/releases/download/v${font_version}/SHA-256.txt"
    rm -rf "$font_dir"
    mkdir -p "$font_dir"
    unzip -q "$font_archive" -d "$font_dir"
    printf '%s\n' "$font_version" > "${font_dir}/.nerd-font-version"
    fc-cache -f "$font_dir"
fi

ghostty_bin="${HOME}/.local/bin/ghostty"
ghostty_layer_shell="${HOME}/.local/lib/libgtk4-layer-shell.so"

patch_ghostty_rpath() {
    if [[ -x "$ghostty_bin" && -f "$ghostty_layer_shell" ]]; then
        # shellcheck disable=SC2016 # The dynamic loader expands $ORIGIN.
        patchelf --set-rpath '$ORIGIN/../lib' "$ghostty_bin"
    fi
}

patch_ghostty_rpath
if ! command -v ghostty >/dev/null 2>&1 || \
    ! ghostty --version 2>&1 | grep -Fq "$ghostty_version"; then
    printf 'Building Ghostty %s...\n' "$ghostty_version"
    zig_archive="${temp_dir}/zig.tar.xz"
    ghostty_archive="${temp_dir}/ghostty.tar.gz"
    ghostty_signature="${ghostty_archive}.minisig"
    ghostty_source="${temp_dir}/ghostty-source"

    download \
        "https://ziglang.org/download/${zig_version}/zig-x86_64-linux-${zig_version}.tar.xz" \
        "$zig_archive"
    download "https://ziglang.org/download/index.json" "${temp_dir}/zig-index.json"
    zig_sha256="$(
        jq -er --arg version "$zig_version" \
            '.[$version]["x86_64-linux"].shasum' \
            "${temp_dir}/zig-index.json"
    )"
    verify_sha256 "$zig_archive" "$zig_sha256"
    tar -xJf "$zig_archive" -C "$temp_dir"

    download \
        "https://release.files.ghostty.org/${ghostty_version}/ghostty-${ghostty_version}.tar.gz" \
        "$ghostty_archive"
    download \
        "https://release.files.ghostty.org/${ghostty_version}/ghostty-${ghostty_version}.tar.gz.minisig" \
        "$ghostty_signature"
    minisign -Vm "$ghostty_archive" \
        -P "RWQlAjJC23149WL2sEpT/l0QKy7hMIFhYdQOFy0Z7z7PbneUgvlsnYcV"

    mkdir -p "$ghostty_source"
    tar -xzf "$ghostty_archive" --strip-components=1 -C "$ghostty_source"
    (
        cd "$ghostty_source"
        "${temp_dir}/zig-x86_64-linux-${zig_version}/zig" build \
            -p "${HOME}/.local" \
            -Doptimize=ReleaseFast \
            -fno-sys=gtk4-layer-shell
    )
    patch_ghostty_rpath
fi

if ldd "$ghostty_bin" | grep -F 'not found'; then
    printf 'Ghostty has unresolved runtime libraries.\n' >&2
    exit 1
fi
{{ end -}}
