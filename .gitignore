# Only the generic SSH template belongs in Stow; hosts and keys stay outside Git.
/stow/ssh/.ssh/*
!/stow/ssh/.ssh/config

# VSCodium - ignore everything except settings and keybindings
.config/VSCodium/*
!.config/VSCodium/User/
.config/VSCodium/User/*
!.config/VSCodium/User/settings.json
!.config/VSCodium/User/keybindings.json
